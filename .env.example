# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (Supabase Edge Functions) — NEVER prefix with VITE_ or this
# would be bundled into the browser build. Set this as a Supabase Edge Function
# secret (`supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...`), not in this file.
# SUPABASE_SERVICE_ROLE_KEY=
